'

[ -n "${AXIS_NODE_BIN_DIR:-}" ] || {
	echo "10-regen-locks: needs Node 24 and npm (run scripts/code-oss/build.sh once or set NODE24_BIN)" >&2
	exit 1
}
export PATH="$AXIS_NODE_BIN_DIR:$PATH"
npm_version="$(npm --version)"
[ "$npm_version" = "$NPM_VERSION" ] || {
	echo "10-regen-locks: npm $npm_version found; the lockfiles are regenerated with npm $NPM_VERSION (bundled with the pinned Node)" >&2
	exit 1
}

work="$(mktemp -d "${TMPDIR:-/tmp}/axis-regen-locks.XXXXXX")"
trap 'rm -rf "$work"' EXIT

for dir in . remote; do
	name="${dir/#./root}"
	if [ "$name" = root ]; then expected="$EXPECTED_ROOT" sha="$SHA256_ROOT"; else expected="$EXPECTED_REMOTE" sha="$SHA256_REMOTE"; fi
	printf '%s\n' "$expected" | sed '/^$/d' >"$work/$name.expected"
	cp "$dir/package-lock.json" "$work/$name.before.json"
	(cd "$dir" && npm install --package-lock-only --ignore-scripts --no-audit --no-fund --loglevel=error)
	node - "$work/$name.before.json" "$dir/package-lock.json" "$dir/package.json" "$dir" "$work/$name.expected" "$ROOT_SDK_NAMES" <<'NODE'
const fs = require('fs');
const [before, after, manifest, dir, expectedFile, sdkNames] = process.argv.slice(2);
const read = f => JSON.parse(fs.readFileSync(f, 'utf8'));
const a = read(before).packages, b = read(after).packages, pkg = read(manifest);
const same = (x, y) => JSON.stringify(x) === JSON.stringify(y);
const removed = Object.keys(a).filter(k => !(k in b)).sort();
const added = Object.keys(b).filter(k => !(k in a)).sort();
const changed = Object.keys(b).filter(k => k !== '' && k in a && !same(a[k], b[k])).sort();
const sdk = /^node_modules\/(@github\/copilot|@vscode\/copilot-api|@anthropic-ai\/|@openai\/codex)/;
const problems = [];
const got = removed.map(k => `${k}@${a[k].version}`);
const want = fs.readFileSync(expectedFile, 'utf8').split('\n').filter(Boolean).sort();
const missing = want.filter(x => !got.includes(x)), extra = got.filter(x => !want.includes(x));
if (missing.length || extra.length) problems.push(`removed set differs from the expected list (not removed: ${missing.join(', ') || 'none'}; unexpectedly removed: ${extra.join(', ') || 'none'})`);
if (added.length) problems.push(`added entries: ${added.join(', ')}`);
if (changed.length) problems.push(`changed entries: ${changed.join(', ')}`);
// The root entry may only lose the agent SDK names from its dependency lists.
const allowed = new Set(sdkNames.split(' '));
const ra = a[''] || {}, rb = b[''] || {};
for (const field of new Set([...Object.keys(ra), ...Object.keys(rb)])) {
	if (field === 'dependencies' || field === 'devDependencies') {
		const da = ra[field] || {}, db = rb[field] || {};
		for (const dep of Object.keys(da)) {
			if (!(dep in db) && !allowed.has(dep)) problems.push(`root ${field} lost ${dep}`);
			if (dep in db && da[dep] !== db[dep]) problems.push(`root ${field} changed ${dep}`);
		}
		for (const dep of Object.keys(db)) if (!(dep in da)) problems.push(`root ${field} gained ${dep}`);
	} else if (!same(ra[field], rb[field])) {
		problems.push(`root entry field ${field} changed`);
	}
}
const left = Object.keys(b).filter(k => sdk.test(k));
if (left.length) problems.push(`agent SDK entries still locked: ${left.join(', ')}`);
if (!(pkg.dependencies || {}).zod) problems.push('zod is no longer a direct dependency');
if (!b['node_modules/zod']) problems.push('zod is not resolved at node_modules/zod');
else if (!same(a['node_modules/zod'], b['node_modules/zod'])) problems.push('node_modules/zod changed');
console.log(`regen-locks ${dir}: ${removed.length} entr${removed.length === 1 ? 'y' : 'ies'} removed, ${added.length} added, ${changed.length} changed`);
for (const k of removed) console.log(`  - ${k}@${a[k].version}${sdk.test(k) ? '' : '  (transitive)'}`);
if (problems.length) {
	console.error(`regen-locks ${dir}: ` + problems.join('; '));
	process.exit(1);
}
NODE
	if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$dir/package-lock.json" | cut -d' ' -f1)"; else actual="$(shasum -a 256 "$dir/package-lock.json" | cut -d' ' -f1)"; fi
	[ "$actual" = "$sha" ] || {
		echo "regen-locks $dir: package-lock.json sha256 $actual, expected $sha" >&2
		exit 1
	}
	echo "regen-locks $dir: package-lock.json sha256 $actual (matches)"
done
