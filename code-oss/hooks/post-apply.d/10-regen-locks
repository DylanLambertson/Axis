node_modules/@anthropic-ai/claude-agent-sdk-win32-arm64@0.3.304
node_modules/@anthropic-ai/claude-agent-sdk-win32-x64@0.3.304
node_modules/@anthropic-ai/sdk@0.82.0
node_modules/@babel/runtime@7.29.2
node_modules/@github/copilot-sdk@1.0.27-unstable.40031404408.gba6c003
node_modules/@github/copilot-sdk-darwin-arm64@1.0.27-unstable.40031404408.gba6c003
