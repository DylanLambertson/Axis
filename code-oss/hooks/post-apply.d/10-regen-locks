#!/usr/bin/env bash
# Regenerates package-lock.json and remote/package-lock.json after the
# Copilot-removal patches drop dependencies (ADR 0002 decision 6: lockfiles are
# regenerated by script, never hand-edited; docs/design/axis-shell.md section 2.8).
#
# Runs `npm install --package-lock-only --ignore-scripts` in . and remote/
# (upstream's own precedent; install scripts never run) and then asserts:
#   - no package entry was added and no remaining entry changed version;
#   - the agent SDK packages are gone from both lockfiles;
#   - zod is still a direct dependency, resolved at top-level node_modules/zod,
#     at the same version (threat model SC-3 check 4, ADR 0003 D2).
# Every removed entry is printed so the sync PR can review it.
#
# Network: the npm registry, for package metadata only.
set -euo pipefail

[ -n "${AXIS_NODE_BIN_DIR:-}" ] || {
	echo "10-regen-locks: needs Node 24 and npm (run scripts/code-oss/build.sh once or set NODE24_BIN)" >&2
	exit 1
}
export PATH="$AXIS_NODE_BIN_DIR:$PATH"
npm_major="$(npm --version | cut -d. -f1)"
[ "$npm_major" -lt 13 ] || {
	echo "10-regen-locks: Code OSS requires npm < 13" >&2
	exit 1
}

work="$(mktemp -d "${TMPDIR:-/tmp}/axis-regen-locks.XXXXXX")"
trap 'rm -rf "$work"' EXIT

for dir in . remote; do
	name="${dir/#./root}"
	cp "$dir/package-lock.json" "$work/$name.before.json"
	(cd "$dir" && npm install --package-lock-only --ignore-scripts --no-audit --no-fund --loglevel=error)
	node - "$work/$name.before.json" "$dir/package-lock.json" "$dir/package.json" "$dir" <<'NODE'
const fs = require('fs');
const [before, after, manifest, dir] = process.argv.slice(2);
const read = f => JSON.parse(fs.readFileSync(f, 'utf8'));
const a = read(before).packages, b = read(after).packages, pkg = read(manifest);
const removed = Object.keys(a).filter(k => !(k in b)).sort();
const added = Object.keys(b).filter(k => !(k in a)).sort();
const changed = Object.keys(b).filter(k => k in a && a[k].version !== b[k].version).sort();
const sdk = /^node_modules\/(@github\/copilot|@vscode\/copilot-api|@anthropic-ai\/|@openai\/codex)/;
const problems = [];
if (added.length) problems.push(`added entries: ${added.join(', ')}`);
if (changed.length) problems.push(`changed versions: ${changed.map(k => `${k} ${a[k].version} -> ${b[k].version}`).join(', ')}`);
const left = Object.keys(b).filter(k => sdk.test(k));
if (left.length) problems.push(`agent SDK entries still locked: ${left.join(', ')}`);
if (!(pkg.dependencies || {}).zod) problems.push('zod is no longer a direct dependency');
if (!b['node_modules/zod']) problems.push('zod is not resolved at node_modules/zod');
console.log(`regen-locks ${dir}: ${removed.length} entr${removed.length === 1 ? 'y' : 'ies'} removed, ${added.length} added, ${changed.length} changed`);
for (const k of removed) console.log(`  - ${k}@${a[k].version}${sdk.test(k) ? '' : '  (transitive)'}`);
if (problems.length) {
	console.error(`regen-locks ${dir}: ` + problems.join('; '));
	process.exit(1);
}
NODE
done
