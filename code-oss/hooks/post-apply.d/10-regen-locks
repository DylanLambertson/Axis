node_modules/@github/copilot-sdk-linuxmusl-x64@1.0.27-unstable.40031404408.gba6c003
node_modules/@github/copilot-sdk-win32-arm64@1.0.27-unstable.40031404408.gba6c003
node_modules/@github/copilot-sdk-win32-x64@1.0.27-unstable.40031404408.gba6c003
node_modules/@github/copilot-sdk/node_modules/zod@4.3.6
node_modules/@koromix/koffi-android-arm64@3.2.1
node_modules/@koromix/koffi-android-x64@3.2.1
