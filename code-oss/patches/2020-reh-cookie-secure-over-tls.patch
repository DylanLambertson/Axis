+// --- Start Axis ---
+/**
+ * Threat model WEB-2 and WEB-5: the connection token cookie is `Secure` only when TLS is in use,
+ * that is when the request itself arrived over TLS or the operator passed --axis-tls-terminated
+ * for a TLS-terminating proxy. `x-forwarded-proto` is never trusted.
+ */
+export function axisConnectionTokenCookieIsSecure(req: Pick<http.IncomingMessage, 'socket'>, tlsTerminated: boolean | undefined): boolean {
+	return tlsTerminated === true || (req.socket as { encrypted?: boolean }).encrypted === true;
+}
+
+export function axisIsLoopbackHost(host: string): boolean {
+	return /^(localhost|127(\.\d{1,3}){3}|::1|\[::1\])$/i.test(host);
+}
+// --- End Axis ---
