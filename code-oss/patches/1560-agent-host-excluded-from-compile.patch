+// --- Start Axis ---
+// Agent host sources that the tsconfig leaves out are not compiled (ADR 0002 decision 6):
+// they import SDK packages that Axis does not install, and tsb fails on files outside the program.
+function axisSkipExcludedAgentHostSources(src: string): NodeJS.ReadWriteStream {
+	const configPath = path.join(import.meta.dirname, '../../', src, 'tsconfig.json');
+	const parsed = ts.getParsedCommandLineOfConfigFile(configPath, undefined, { ...ts.sys, onUnRecoverableConfigFileDiagnostic: d => { throw new Error(ts.flattenDiagnosticMessageText(d.messageText, '\n')); } });
+	const roots = new Set((parsed?.fileNames ?? []).map(f => path.normalize(f)));
+	return util.filter(data => !/[\\/]platform[\\/]agentHost[\\/]/.test(data.path) || !data.path.endsWith('.ts') || roots.has(path.normalize(data.path)));
+}
+// --- End Axis ---
