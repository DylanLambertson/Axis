+// --- Start Axis ---
+/** Threat model EL-5: the only URL schemes that openExternal hands to the operating system. */
+export const AXIS_OPEN_EXTERNAL_ALLOWED_SCHEMES: readonly string[] = ['http', 'https', 'mailto'];
+
+/**
+ * What a log line may say about a refused URL: its scheme when that is a valid scheme token of at most 32
+ * characters, and nothing else, because any other part of a URL can carry tokens or line breaks.
+ */
+export function axisOpenExternalSchemeForLog(url: string): string {
+	const scheme = /^([a-z][a-z0-9+.-]{0,15}):/i.exec(url)?.[1].toLowerCase();
+	return scheme ?? 'invalid';
+}
+
+export function axisIsAllowedOpenExternalUrl(url: string): boolean {
+	const scheme = /^([a-z][a-z0-9+.-]*):/i.exec(url)?.[1].toLowerCase();
+	return scheme !== undefined && AXIS_OPEN_EXTERNAL_ALLOWED_SCHEMES.includes(scheme);
+}
+// --- End Axis ---
