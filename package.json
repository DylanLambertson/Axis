{
  "name": "project-axis",
  "version": "0.0.0",
  "private": true,
  "description": "Axis-owned TypeScript packages that live outside the Code OSS overlay.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.1",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -b",
    "gate": "node scripts/gate.mjs",
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "test": "node scripts/test-all.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2"
  }
}
