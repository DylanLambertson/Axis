{
  "name": "project-axis",
  "version": "0.0.0",
  "private": true,
  "description": "Axis-owned TypeScript packages that live outside the Code OSS overlay.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/*",
    "typecheck": "tsc -b packages/* && npm run typecheck --workspaces --if-present",
    "test": "npm run build && npm test --workspaces --if-present",
    "clean": "tsc -b --clean packages/*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
