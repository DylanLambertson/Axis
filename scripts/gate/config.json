{
  "lineLimit": 500,
  "lineLimitExemptFiles": ["package-lock.json"],
  "lineLimitExemptPaths": ["scripts/code-oss/icons/jobs.json"],
  "lineLimitExemptExtensions": [".png", ".icns", ".xpm", ".svg", ".patch", ".lock", ".ico", ".jpg", ".woff", ".woff2"],
  "forbiddenWording": [
    "co-authored-by",
    "generated with",
    "generated by",
    "ai-generated",
    "claude",
    "copilot",
    "chatgpt",
    "codex",
    "gemini",
    "assistant",
    "agent"
  ],
  "allowedPhrases": [
    "CLI agent",
    "CLI agents",
    "axis-agent-shell",
    "agent_runs",
    "agent_workspaces",
    "user-agent",
    "assistant role",
    "agent-first"
  ]
}
